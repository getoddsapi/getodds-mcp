{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.getoddsapi/getodds",
  "description": "Odds and props: DraftKings, FanDuel, BetRivers, Pinnacle, Novig, PrizePicks, Underdog, Pick6.",
  "title": "GetOdds",
  "repository": {
    "url": "https://github.com/getoddsapi/getodds-mcp",
    "source": "github"
  },
  "version": "0.1.2",
  "websiteUrl": "https://getoddsapi.com/mcp",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "getodds-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Free key from https://getoddsapi.com/sign-up. Optional: the board tools work without it.",
          "format": "string",
          "isSecret": true,
          "name": "GETODDS_API_KEY"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://getoddsapi.com/api/mcp",
      "headers": [
        {
          "description": "Bearer <your GetOdds key>. Optional: initialize, tools/list and get_sandbox_odds work without it.",
          "isRequired": false,
          "isSecret": true,
          "name": "Authorization"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://getoddsapi.com/assets/getodds-mark.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://getoddsapi.com/assets/getodds-icon-180.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ]
}